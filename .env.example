# ==============================================================================
# Chronos Surveillance OS - Distributed Smart City Environment Configuration
# Pure Open-Source Architecture (100% Zero-AWS / Zero-Vendor-Lockin)
# ==============================================================================

# ------------------------------------------------------------------------------
# System Identity & Deployment
# ------------------------------------------------------------------------------
ENVIRONMENT=development
SYSTEM_NAME="Chronos Surveillance OS"
CITY_ZONE="Metropolis Sector-07"
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Message Broker (Redpanda / Apache Kafka)
# ------------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_VIDEO_INGEST=chronos.video.raw-frames
KAFKA_TOPIC_ANOMALIES=chronos.threats.anomalies
KAFKA_TOPIC_BIOMETRICS=chronos.recon.biometrics
KAFKA_TOPIC_AGENT_ACTIONS=chronos.agentic.actions

# ------------------------------------------------------------------------------
# Local LLM & Reasoning Engine (Gemma-4 / OpenAI Compatible Server)
# ------------------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL=google/gemma-4-E4B-it-qat-q4_0-gguf:Q4_0
LLM_BASE_URL=http://10.210.8.63:8080/v1
LLM_ENABLE_THINKING=true
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# Cloud API Fallbacks (Optional - Keep blank if 100% offline)
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# Vector Database & Feature Stores (Qdrant / ChromaDB / Milvus)
# ------------------------------------------------------------------------------
VECTOR_DB_TYPE=chromadb
VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=6333
CHROMA_PERSIST_DIR=./data/vector_store
CHROMA_COLLECTION_BIOMETRICS=biometric_identities

# ------------------------------------------------------------------------------
# Knowledge Graph & Ontology (Neo4j / In-Memory NetworkX)
# ------------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=chronos_surveillance_pass

# ------------------------------------------------------------------------------
# Embedding Model (Offline HuggingFace / SentenceTransformers)
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# ------------------------------------------------------------------------------
# Object Storage (MinIO - S3 Compatible / Local FS)
# ------------------------------------------------------------------------------
STORAGE_BACKEND=local
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
STORAGE_BUCKET_SNAPSHOTS=surveillance-snapshots
STORAGE_BUCKET_3DMESH=biometric-3d-meshes
LOCAL_STORAGE_DIR=./data/storage

# ------------------------------------------------------------------------------
# Camera Feeds & Video Ingestion Gateways
# ------------------------------------------------------------------------------
# 0: Local laptop webcam, RTSP url: rtsp://user:pass@ip:554/stream, or Phone IP Webcam: http://ip:8080/video
PRIMARY_CAMERA_SOURCE=0
SECONDARY_CAMERA_SOURCE=http://192.168.1.50:8080/video
VIDEO_TARGET_FPS=15
FRAME_WIDTH=1280
FRAME_HEIGHT=720

# ------------------------------------------------------------------------------
# Biometric Reconnaissance & 3D Profiling
# ------------------------------------------------------------------------------
FACE_SIMILARITY_THRESHOLD=0.68
GENERATE_3D_MESH=true
MESH_OUTPUT_DIR=./data/3d_profiles
ALLOW_HUMAN_IN_THE_LOOP_AUTO_ENROLL=true

# ------------------------------------------------------------------------------
# Alert & Notifications (Local SMTP / Webhooks)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=khushalpareta9@gmail.com
SMTP_PASSWORD=qgid nzho skhr bmgl
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=khushalpareta9@gmail.com
ALERT_RECIPIENT_EMAIL=khushalpareta9@gmail.com
